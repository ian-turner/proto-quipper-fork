module CtrlAdder where
import "lib/Prelude.dpq"
-- Permutation of wires 
permute : !(Qubit * Qubit * Qubit * Qubit -> Qubit * Qubit * Qubit * Qubit)
permute x =
  let (a, b, c, d) = x in (d, c, b, a)

permuteCirc : Circ(Qubit * Qubit * Qubit * Qubit, Qubit * Qubit * Qubit * Qubit)
permuteCirc = boxCirc permute

cpermuteCirc : Circ(Qubit * (Qubit * Qubit * Qubit * Qubit), Qubit * (Qubit * Qubit * Qubit * Qubit))
cpermuteCirc = control permuteCirc


-- QFT 
rotate : ! forall (y : Nat) -> Nat -> Qubit -> Vec Qubit y -> Qubit * Vec Qubit y
rotate m q v =
    case v of
      VNil -> (q, VNil)
      VCons x xs ->
        let (q', x') = R m q x
            (q'', xs') = rotate (S m) q' xs
        in (q'', VCons x' xs')

qft : ! forall (n : Nat) -> Vec Qubit n -> Vec Qubit n
qft v =
  case v of
    VNil -> VNil
    VCons q qs ->
      let q' = H q
          (q'', qs') = rotate (S (S Z)) q' qs
          qs'' = qft qs'
      in VCons q'' qs''

qftBox : ! (n : Nat) -> Circ(Vec Qubit n, Vec Qubit n) 
qftBox n = boxCirc (\ x -> qft x)

qftCtrl : ! (n : Nat) -> Circ(Qubit * Vec Qubit n, Qubit * Vec Qubit n) 
qftCtrl n = control (qftBox n)

qft' : ! (n : Nat) -> Vec Qubit n -> Vec Qubit n
qft' n l = reverse_vec (qft l)

qftBox' : ! (n : Nat) -> Circ(Vec Qubit n, Vec Qubit n) 
qftBox' n = boxCirc (\ x -> qft' n x)

qftCtrl' : ! (n : Nat) -> Circ(Qubit * Vec Qubit n, Qubit * Vec Qubit n) 
qftCtrl' n = control (qftBox' n)

-- QFT addition
crotate_h : ! forall (m : Nat) -> Nat -> Qubit -> Vec Qubit m -> Vec Qubit m * Qubit
crotate_h n b l =
  case l of
    VNil -> (VNil, b)
    VCons q' qs' ->
        let (b', c) = R n b q'
            (res, b'') = crotate_h (S n) b' qs'
        in (VCons c res, b'')
		    
crotate : ! forall (n : Nat) -> Vec Qubit n -> Vec Qubit n -> Vec Qubit n * Vec Qubit n
crotate as bs =
  case bs of
    VNil -> (as, VNil)
    VCons b bs ->
      let (as', b') = crotate_h (S Z) b as in
      case as' of
        VCons c cs -> 
          let (cs', bs') = crotate cs bs in
          (VCons c cs', VCons b' bs')


crotateBox : ! (n : Nat) -> Circ(Vec Qubit n * Vec Qubit n, Vec Qubit n * Vec Qubit n) 
crotateBox n = boxCirc $ \ x -> let (a, b) = x in let (as, bs) = crotate a b in (as, bs)


ctrl_crotateBox : ! (n : Nat) -> Circ(Qubit * (Vec Qubit n * Vec Qubit n), Qubit * (Vec Qubit n * Vec Qubit n))
ctrl_crotateBox n = control (crotateBox n)

extendWires : ! (n : Nat) -> Circ(Vec Qubit n, Vec Qubit n) ->
               Circ(Vec Qubit n * Vec Qubit n, Vec Qubit n * Vec Qubit n)
extendWires n circ = box (Vec Qubit n * Vec Qubit n) $
                       \ x -> let (a, b) = x in (a, (unbox circ) b)

qft_adder : ! (n : Nat) -> Circ(Vec Qubit n * Vec Qubit n, Vec Qubit n * Vec Qubit n)
qft_adder n =
    withComputed (extendWires n $ qftBox n) (crotateBox n)

qft_adder' : ! (n : Nat) -> Circ(Vec Qubit n * Vec Qubit n, Vec Qubit n * Vec Qubit n)
qft_adder' n =
    withComputed (extendWires n $ qftBox' n) (crotateBox n)

qft_adder_manual : ! (n : Nat) -> Circ(Vec Qubit n * Vec Qubit n, Vec Qubit n * Vec Qubit n)
qft_adder_manual n =
  boxCirc $ \ x ->
    unbox (reverse (extendWires n $ qftBox n)) ((unbox (crotateBox n)) (unbox (extendWires n $ qftBox n) x)) 


ctrl_add : ! (n : Nat) -> Circ(Qubit * (Vec Qubit n * Vec Qubit n), Qubit * (Vec Qubit n * Vec Qubit n))
ctrl_add n = control (qft_adder n)

ctrl_add' : ! (n : Nat) -> Circ(Qubit * (Vec Qubit n * Vec Qubit n), Qubit * (Vec Qubit n * Vec Qubit n))
ctrl_add' n = control (qft_adder' n) 

ctrl_add_manual : ! (n : Nat) -> Circ(Qubit * (Vec Qubit n * Vec Qubit n), Qubit * (Vec Qubit n * Vec Qubit n))
ctrl_add_manual n =  control (qft_adder_manual n)
