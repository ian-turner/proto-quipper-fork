testGray : Circ(VecZipper Qubit 2 0,  VecZipper Qubit 2 0)
testGray = boxCirc (\ x -> gray (VZ [False, False] False []) (VZ [False, True] True []) x)

testGray2 : Circ(VecZipper Qubit 0 0,  VecZipper Qubit 0 0)
testGray2 = boxCirc (\ x -> gray (VZ [] False []) (VZ [] True []) x)


twoLevel : ! (n : Nat) -> !(Qubit -> Qubit) -> (j k : Nat) ->
                 Eq Bool (j <= exponential 2 n) True -> Eq Bool (k <= exponential 2 n) True -> 
                Vec Qubit n -> Vec Qubit n
twoLevel n u j k p1 p2 x =
   case n of
     Z -> x
     S n' ->
       let VCons s1 ss = toBinary n j
           VCons t1 ts = toBinary n k
           s = VZ ss s1 []
           t = VZ ts (not t1) []
           VCons x1 xs = x
           VZ xs x1 xr = gray s t (VZ xs x1 [])
           (x1, xs, xr) = signControlUnitary (\ x y -> controlled (box Qubit u) x y) x1 (xs, ts) (xr, [])
           gray_inv = unbox $ reverse $ boxCirc (\ x -> gray s t x)
           VZ xs x1 r = gray_inv (VZ xs x1 xr)
           VNil = r
        in VCons x1 xs
           
testTwoLevel : Circ(Vec Qubit 4, Vec Qubit 4)
testTwoLevel = boxCirc (\ x -> twoLevel 4 H 0 12 refl refl x)
           
           

  
