module TwoLevel where

import "lib/Prelude.dpq"


toBinary' : ! (Nat -> List Nat) 
toBinary' n =
  case n of
    Z -> Nil
    S n' -> 
     let (q, r) = divMod n 2
         rs = toBinary' q
     in Cons r rs

-- Convert the number 'j' to a n-digit binary (with the most significant bit at the end of the vector).
-- If n is less than the 'natural' digit of 'j', then the result is truncated. 
toBinary : ! (n : Nat) -> Nat -> Vec Bool n
toBinary n j =
  case n of
    Z -> VNil
    S n' ->
      case j of
        Z -> repeat False n
        S _ ->
          let (q, r) = divMod j 2
              rs = toBinary n' q
              r = if r == 0 then False else True
           in VCons r rs


signControlUnitary : ! forall (n m : Nat) -> !(forall s -> (Simple s) => Qubit -> s -> Qubit * s) ->
                        Qubit -> Vec Qubit n * Vec Bool n -> Vec Qubit m * Vec Bool m -> Qubit * Vec Qubit n * Vec Qubit m
signControlUnitary cu q lp rp =
  let (ws1, bs1) = lp
      (ws2, bs2) = rp
      ws1 = zipWith (\ q b -> if b then q else QNot q) ws1 bs1
      ws2 = zipWith (\ q b -> if b then q else QNot q) ws2 bs2
      (q, wss) = cu q (ws1, ws2)
      (ws1, ws2) = wss
      ws1 = zipWith (\ q b -> if b then q else QNot q) ws1 bs1
      ws2 = zipWith (\ q b -> if b then q else QNot q) ws2 bs2
 in (q, ws1 , ws2)
      


gray : ! forall (n m : Nat) -> VecZipper Bool n m -> VecZipper Bool n m ->
          VecZipper Qubit n m -> VecZipper Qubit n m
gray s t x =
  let VZ ls s1 rs = s
      VZ lt t1 rt = t
      VZ l q r = x
  in if s1 == t1
     then case ls of
            VNil -> VZ l q r
            VCons y ys ->
              let VCons z zs = lt
                  VCons u us = l
              in backward
                  (gray (VZ ys y (VCons s1 rs)) (VZ zs z (VCons t1 rt)) (VZ us u (VCons q r)))
                              
     else
     case ls of
            VNil ->
              let (q, l, r) = signControlUnitary (\ x y -> not_g x y) q (l, ls) (r, rs)
              in VZ l q r
            VCons y ys ->
              let VCons z zs = lt
                  s' = VZ ys y (VCons (not s1) rs)
                  t' = VZ zs z (VCons t1 rt)
                  (q, l, r) = signControlUnitary (\ x y -> not_g x y) q (l, ls) (r, rs)
                  VCons u us = l
              in backward (gray s' t' (VZ us u (VCons q r))) 

