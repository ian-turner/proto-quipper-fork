  in case l of
       VNil ->
         let VZ xl x1 xr = x
             (x1, xr, xl) = signControlUnitary (\ x y -> cu x y) x1 (xr, r) (xl, [])
         in VZ xl x1 xr
       VCons y ys ->
         backward (controlUnitary u (VZ ys y (VCons v1 r)) (forward x))
