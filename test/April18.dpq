make_toffoli : !(Qubit -> Qubit -> Qubit -> Qubit * Qubit * Qubit)
make_toffoli c b a = 
  let 
      c = H c
      (c, b) = CNot c b
      c = tgate_inv c
      (c, a) = CNot c a
      c = tgate c
      (c, b) = CNot c b
      c = tgate_inv c
      (c, a) = CNot c a
      c = H (TGate c)
      b = tgate b
      (b, a) = CNot b a
      a = tgate a
      b = tgate_inv b
      (b, a) = CNot b a
  in (c, b, a)


boxTof = boxCirc $ \ x -> uncurry (uncurry make_toffoli) x

