main1 = box Qubit f

main (x : Qubit) = unbox main1 x

main2 : ! (Qubit -> Qubit -> Qubit * Qubit)
main2 = controlling f 

-- main3 : ! (Qubit -> Qubit -> Qubit * Qubit)
main3 = box (Qubit * Qubit) (\ x -> uncurry main2 x)
