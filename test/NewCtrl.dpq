module NewCtrl where
import "lib/Prelude.dpq"


swap' : !(Qubit* Qubit -> Qubit* Qubit)
swap' x =
  let (a, b) = x in (b, a)

swapCirc : Circ(Qubit* Qubit , Qubit * Qubit)
swapCirc = box (Qubit* Qubit) swap'


cswap : !(Qubit * Qubit * Qubit -> Qubit * Qubit * Qubit)
cswap x = uncurry (controlled swapCirc) x


mycnot : Circ(Qubit * Qubit , Qubit * Qubit)
mycnot = -- boxCirc $ \ x -> let (a, b) = x in CNot b a
boxCirc $ \ x -> let (a, b) = x in let (x, y) = (CNot b a) in CNot y x

cmycnot : Circ(Qubit * Qubit * Qubit , Qubit * Qubit  * Qubit)
cmycnot = boxCirc $ \ x -> let (a, b, c) = x in controlled mycnot (a, b) c

cswapCirc : Circ(Qubit* Qubit * Qubit , Qubit * Qubit * Qubit)
cswapCirc = box (Qubit* Qubit * Qubit) cswap


g : !(Qubit * Qubit -> Qubit * Qubit)
g x =
  let (a, b) = x
      _ = Term0 a
      _ = Term0 b
  in (Init0 (), Init0 ())

gCirc = boxCirc g

