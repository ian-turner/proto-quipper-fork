ccswap : !(Qubit * Qubit * Qubit -> Qubit -> Qubit * Qubit * Qubit * Qubit)
ccswap x y =
  let (a, b, c, d) = controlled cswapCirc x y
  in (a, b, d, c)

ccswapCirc : Circ(Qubit* Qubit * Qubit * Qubit, Qubit * Qubit * Qubit * Qubit)
ccswapCirc = box (Qubit* Qubit * Qubit * Qubit) $ \ x -> let (a, b, c, d) = x in ccswap (a, b, c) d

cccswap : !(Qubit * Qubit * Qubit * Qubit -> Qubit -> Qubit * Qubit * Qubit * Qubit * Qubit)
cccswap = controlled ccswapCirc

cccswapCirc : Circ(Qubit* Qubit * Qubit * Qubit * Qubit , Qubit * Qubit * Qubit * Qubit * Qubit)
cccswapCirc = boxCirc $ \ x -> let (a, b, c, d, e) = x in cccswap (a, b, c, d) e


cccswap' : !(Qubit * Qubit * Qubit * Qubit -> Qubit -> Qubit * Qubit * Qubit * Qubit * Qubit)
cccswap' = controlled (reverse ccswapCirc)

cccswapCirc' : Circ(Qubit* Qubit * Qubit * Qubit * Qubit , Qubit * Qubit * Qubit * Qubit * Qubit)
cccswapCirc' = boxCirc $ \ x -> let (a, b, c, d, e) = x in cccswap' (a, b, c, d) e

rotate : ! forall (y : Nat) -> Nat -> Qubit -> Vec Qubit y -> Qubit * Vec Qubit y
rotate m q v =
    case v of
      VNil -> (q, VNil)
      VCons x xs ->
        let (q', x') = R m q x
            (q'', xs') = rotate (S m) q' xs
        in (q'', VCons x' xs')

qft : ! forall (n : Nat) -> Vec Qubit n -> Vec Qubit n
qft v =
  case v of
    VNil -> VNil
    VCons q qs ->
      let q' = H q
          (q'', qs') = rotate (S (S Z)) q' qs
          qs'' = qft qs'
      in VCons q'' qs''

qft' : ! (n : Nat) -> Vec Qubit n -> Vec Qubit n
qft' n l = (qft (reverse_vec l))

qftBox : ! (n : Nat) -> Circ(Vec Qubit n, Vec Qubit n) 
qftBox n = box (Vec Qubit n) (\ x -> qft x)

qftBoxRev : ! (n : Nat) -> Circ(Vec Qubit n, Vec Qubit n) 
qftBoxRev n = reverse $ box (Vec Qubit n) (\ x -> qft (reverse_vec x))

qftBoxRevC : ! (n : Nat) -> Circ(Vec Qubit n * Qubit, Vec Qubit n * Qubit) 
qftBoxRevC n = boxCirc (\ x -> let (a, b) = x in controlled (qftBoxRev n) a b )

qftBox' : ! (n : Nat) -> Circ(Vec Qubit n, Vec Qubit n) 
qftBox' n = box (Vec Qubit n) (\ x -> qft' n x)

qft_ctrl : ! (n : Nat) -> Circ(Vec Qubit n * Vec Qubit n, Vec Qubit n * Vec Qubit n)
qft_ctrl n = box (Vec Qubit n * Vec Qubit n) $ \ i ->
                        let (inputs, c) = i in controlled (qftBox n) inputs c

qft_Box'_ctrl : ! (n : Nat) -> Circ(Vec Qubit n * Vec Qubit n, Vec Qubit n * Vec Qubit n)
qft_Box'_ctrl n = box (Vec Qubit n * Vec Qubit n) $ \ i ->
                        let (inputs, c) = i in controlled (qftBox' n) inputs c


qft_adder_h : ! forall (m : Nat) -> Nat -> Qubit -> Vec Qubit m -> Vec Qubit m * Qubit
qft_adder_h n b l = case l of
       	     	        VNil -> (VNil, b)
                        VCons q' qs' ->
            		    let (b', c) = R n b q'
			    	(res, b'') = qft_adder_h (S n) b' qs'
		            in (VCons c res, b'')
		    

qft_adder : ! forall (n : Nat) -> Vec Qubit n -> Vec Qubit n -> Vec Qubit n * Vec Qubit n
qft_adder as bs = case bs of
                      VNil -> (as, VNil)
                      VCons b bs ->
		         let (as', b') = qft_adder_h (S Z) b as in
  			 case as' of
			  VCons c cs -> 
		            let (cs', bs') = qft_adder cs bs in
		             (VCons c cs', VCons b' bs')


adderBox : ! (n : Nat) -> Circ(Vec Qubit n * Vec Qubit n, Vec Qubit n * Vec Qubit n) -- reverse_vec 
adderBox n = box (Vec Qubit n * Vec Qubit n) $ \ x -> let (a, b) = x in let (as, bs) = qft_adder a b in (as, reverse_vec bs)

ctrl_adderBox : ! (n : Nat) -> Circ(Vec Qubit n * Vec Qubit n * Qubit, Vec Qubit n * Vec Qubit n * Qubit)
ctrl_adderBox n =
  box (Vec Qubit n * Vec Qubit n * Qubit) $ \ x -> let (a, b, c) = x in controlled (adderBox n) (a, b) c

extendWires : ! (n : Nat) -> Circ(Vec Qubit n, Vec Qubit n) ->
               Circ(Vec Qubit n * Vec Qubit n, Vec Qubit n * Vec Qubit n)
extendWires n circ = box (Vec Qubit n * Vec Qubit n) $
                       \ x -> let (a, b) = x in (a, (unbox circ) b)


qft_adder_inplace : ! (n : Nat) -> Circ(Vec Qubit n * Vec Qubit n, Vec Qubit n * Vec Qubit n)
qft_adder_inplace n =
    withComputed (extendWires n $ qftBox n) (adderBox n)

qft_adder_manual : ! (n : Nat) -> Circ(Vec Qubit n * Vec Qubit n, Vec Qubit n * Vec Qubit n)
qft_adder_manual n =
                 boxCirc $ \ x -> unbox (reverse (extendWires n $ qftBox n)) ((unbox (adderBox n)) (unbox (extendWires n $ qftBox n) x)) 


ctrl_add : ! (n : Nat) -> Circ(Vec Qubit n * Vec Qubit n * Qubit, Vec Qubit n * Vec Qubit n * Qubit)
ctrl_add n =
  box (Vec Qubit n * Vec Qubit n * Qubit) $ \ x -> let (a, b, c) = x in controlled (qft_adder_inplace n) (a, b) c

ctrl_add' : ! (n : Nat) -> Circ(Vec Qubit n * Vec Qubit n * Qubit, Vec Qubit n * Vec Qubit n * Qubit)
ctrl_add' n =
  box (Vec Qubit n * Vec Qubit n * Qubit) $ \ x -> let (a, b, c) = x in controlled (qft_adder_manual n) (a, b) c



