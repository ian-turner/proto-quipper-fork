module Dynlift where

import "lib/Prelude.dpq"

binary : ! {x : Nat} -> Vec Bool x -> Nat
binary x l =
  let v = dynlift (Meas (Init0 ()))
  in 
  case x of
    Z -> Z
    S n ->
      let VCons y ys = l
      in if y then exponential 2 n + binary ys
              else binary ys

