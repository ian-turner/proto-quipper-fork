ghz : ! forall (n : Nat) -> Vec Qubit n -> Vec Qubit n
ghz ls =
  case ls of
     VNil -> VNil
     VCons y ys ->
       let ys' = ghz ys
       in case ys' of
             VNil -> VCons (H y) VNil
             VCons x xs ->
               let (y, x) = CNot y x
               in VCons y (VCons x xs)

ghz' : ! forall (n : Nat) -> Qubit -> Vec Qubit n -> Qubit * Vec Qubit n
ghz' q ls =
  case ls of
     VNil -> (H q, VNil)
     VCons y ys ->
       let (q, ys') = ghz' q ys 
           (y, q) = CNot y q
       in (q, VCons y ys')

boxGHZ : ! (n : Nat) -> Circ(Vec Qubit n, Vec Qubit n)
boxGHZ n = box (Vec Qubit n) (\ x -> ghz x)

boxGHZ' : ! (n : Nat) -> Circ(Qubit * Vec Qubit n, Qubit * Vec Qubit n)
boxGHZ' n = box (Qubit * Vec Qubit n) (\ x -> uncurry ghz' x)

