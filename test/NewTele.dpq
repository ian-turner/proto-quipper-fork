-- * Teleportation by measuring in the end. No classical
-- information is transmitted. Note that in this case teleportation
-- can be described entirely using Clifford gates.

alice_g : ! (n : Nat) -> Vec Qubit n -> Vec Qubit n -> Vec Qubit n * Vec Qubit n
alice_g n q a = let (a', q') = unzip $ zipWith CNot a q
                    q'' = map H q'
                in (q'', a')

-- Controlled Z gate, which is a member of Clifford group.
cz (x y : Qubit) = let (x, y) = CNot (H x) y in (H x, y)

bob_g : ! (n : Nat) -> Vec Qubit n -> (Vec Qubit n * Vec Qubit n) ->
              Vec Qubit n * (Vec Qubit n * Vec Qubit n)
bob_g n b u = let (x, y) = u
                  (b, y) = unzip $ zipWith CNot b y
                  (b, x) = unzip $ zipWith cz b x
              in (b, (x, y))

tele_g : ! (n : Nat) -> Vec Qubit n -> Vec Qubit n * (Vec Qubit n * Vec Qubit n)
tele_g n q = let (a, b) = bell n
                 (x, y) = alice_g n q a
                 (b, xy) = bob_g n b (x, y)
              in (b, xy)

boxTeleG (n : Nat) = box (Vec Qubit n) $ \ x -> tele_g n x

-- Using the #Clifford flag, the following function is run 
-- as a clifford circuit, which allows teleporting much more
-- qubits. Note that by using #Clifford flag, it is currently
-- the programmers' job to ensure using only clifford gates, and
-- ensure measuring all the qubits before dynamic lifting. So
-- stabilizer formalism does not work well with partial dynamic lifting.

#Clifford
teleTest2 =
 let (b, xy) = tele_g 1000 (initVec 500 True ++ initVec 500 False)
     (x, y) = xy
     x' = map Meas x
     y' = map Meas y
     b' = map Meas b
     _ = map dynlift x'
     _ = map dynlift y'
     r = map dynlift b'
 in r

