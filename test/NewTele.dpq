module NewTele where
import "lib/Prelude.dpq"


bell00 : Bool * Bool
bell00 = let x = Init0 ()
             y = Init0 ()
             x  = H x
             (y, x) = CNot y x
         in (dynlift (Meas y), dynlift (Meas x))



-- * Teleportation by dynmaic lifting, there is no classically controlled
-- quantum gates used.

plus_minus : ! (n : Nat) -> Bool -> Vec Qubit n
plus_minus n b = let qs = initVec n b in map H qs

share : ! (n : Nat) -> Vec Qubit n -> Vec Qubit n * Vec Qubit n
share n l =
  let res = initVec n False
      (res', l) = unzip $ zipWith CNot res l
  in (l, res')

bell : ! (n : Nat) -> Vec Qubit n * Vec Qubit n
bell n =
    let a = plus_minus n False
        (a, b) = share n a
    in (a, b)

alice : ! (n : Nat) -> Vec Qubit n -> Vec Qubit n ->
           Vec Bool n * Vec Bool n
alice n q a =
  let (a', q') = unzip $ zipWith CNot a q
      q'' = map H q'
  in (measure q'', measure a')

bob : ! forall (n : Nat) -> Vec Qubit n ->
                (Vec Bool n * Vec Bool n) -> Vec Qubit n
bob b u =
  let (x, y) = u
      (b, y) = unzip $
                zipWith
                  (\ q c  -> if c then (QNot q, c) else (q, c)) b y
      (b, x) = unzip $
                zipWith
                  (\ q c -> if c then (ZGate q, c) else (q, c)) b x
  in b

-- The following teleportation function is not boxable! 
-- tele_generic : !{0,0,0}((n : Nat) -> Vec Qubit n -> Vec Qubit n)
tele_generic : ! (n : Nat) -> Vec Qubit n -> Vec Qubit n
tele_generic n q =
  let (a, b) = bell n
      (x, y) = alice n q a
      b = bob b (x, y)
  in b

