module AdderN where
import "lib/Prelude.dpq"


adder' : ! (Qubit -> Qubit -> Qubit -> WithGarbage (Qubit * Qubit))
adder' a b carry_in =
     let (a1, a2, a3) = copyT a
         (b1, b2, b3) = copyT b
         (carry_in1, carry_in2, carry_in3) = copyT carry_in
     in do s <- [| bxor (bxor a1 b1) (pure carry_in1) |]
           carry_out <- [|bor [|bor (band a2 b2) (band a3 carry_in2)|] (band b3 carry_in3)|]
           return (s, carry_out)

adder'' : ! (Qubit -> Qubit -> Qubit -> WithGarbage (Qubit * Qubit))
adder'' a b carry_in = do
     let (a1, a2, a3) = copyT a
         (b1, b2, b3) = copyT b
         (carry_in1, carry_in2, carry_in3) = copyT carry_in 
     s <- [| bxor (bxor a1 b1) (pure carry_in1) |]
     carry_out <- [|bor [|bor (band a2 b2) (band a3 carry_in2)|] (band b3 carry_in3)|]
     return (s, carry_out)

adder : ! (Qubit -> Qubit -> Qubit -> WithGarbage (Qubit * Qubit))
adder a b carry_in =
     let (a1, a2, a3) = copyT a
         (b1, b2, b3) = copyT b
         (carry_in1, carry_in2, carry_in3) = copyT carry_in
     in do r1 <- bxor a1 b1
           s <- bxor r1 carry_in1
           r2 <- band a2 b2
           r3 <- band a3 carry_in2
           r4 <- bor r2 r3
           r5 <- band b3 carry_in3
           carry_out <- bor r4 r5
           return (s, carry_out)


nAdder : ! (n : Nat) -> Qubit -> Vec Qubit n -> Vec Qubit n ->
               WithGarbage (Vec Qubit n * Qubit)
nAdder n carry_in as bs =
  case n of
    Z ->
     let VNil = as
         VNil = bs
     in return (VNil, carry_in)
    S n' ->
     let VCons x xs = as
         VCons y ys = bs
     in do (s, carry_out) <- adder x y carry_in
           (res, carry_out') <- nAdder n' carry_out xs ys
  	   return (VCons s res, carry_out')



with_computed_c : ! {a b c d : Type} -> (Simple a, Simple b, Simple c, Simple d) =>
                   Circ(a, d * b) -> Circ(b * c, b * c) -> Circ(a * c, a * c)
with_computed_c a b c d f g =
  let fCirc = box (a * c) (\ x -> let (u1, u2) = x in (unbox f u1, u2))
      gCirc = box (d * b * c) (\ x -> let (u1, u2, u3) = x in let (u2, u3) = unbox g (u2, u3) in (u1, u2, u3))
  in withComputed fCirc gCirc

with_computed_g : !{a b c : Type} ->
                    (Simple a, Simple b, Simple c) =>
                    !(a -> WithGarbage b) ->
                    !(b * c -> b * c) -> Circ(a * c, a * c)
with_computed_g a b c f g =
  let (_, circ) = existsBox a (λx -> Vec Qubit x * b) (λz -> runGarbage (f z))
      gCirc = box (b * c) g 
      h = with_computed_c circ gCirc
  in h


nAdderRev : ! (n : Nat) -> Circ(Qubit * Vec Qubit n * Vec Qubit n,
                                   Vec Qubit n * Qubit *
				     (Qubit * Vec Qubit n * Vec Qubit n))

nAdderRev n = box (Qubit * Vec Qubit n * Vec Qubit n) $ \ x ->
  let c = without_garbage (Qubit * Vec Qubit n * Vec Qubit n)
            (Vec Qubit n * Qubit)
            (\ x -> let (carry_in, a, b) = x in nAdder n carry_in a b) 
            copy 
  in c x

nAdderRev' : ! (n : Nat) -> Circ(Qubit * Vec Qubit n * Vec Qubit n * (Vec Qubit n * Qubit),
                                   Qubit * Vec Qubit n * Vec Qubit n * (Vec Qubit n * Qubit))
nAdderRev' n =
  with_computed_g (\ x -> let (q, as, bs) = x in uncurry (uncurry (nAdder n)) (q,  as, bs))
   (\ x -> let (a, b, c) = x
               (c, ab) = cnots c (a, b)
               (a, b) = ab
           in (a, b, c)
          )

nAdderRev'' : ! (n : Nat) -> Circ(Qubit * Vec Qubit n * Vec Qubit n * (Vec Qubit n * Qubit),
                                   Qubit * Vec Qubit n * Vec Qubit n * (Vec Qubit n * Qubit))
nAdderRev'' n =
  boxCirc $
    \ x -> let (c, as, bs, outs) = x
               (ss, cout) = outs
               (c, as, bs, outs) = unbox (nAdderRev' n) (c, reverse_vec as, reverse_vec bs, (reverse_vec ss, cout))
               (ss', cout) = outs
           in (c, reverse_vec as, reverse_vec bs, (reverse_vec ss', cout))
           
c_adderRev' : ! (n : Nat) -> Circ(Qubit * Vec Qubit n * Vec Qubit n * (Vec Qubit n * Qubit) * Qubit,
                               Qubit * Vec Qubit n * Vec Qubit n * (Vec Qubit n * Qubit) * Qubit)
c_adderRev' n = boxCirc $ \ x -> let (a, b, c, d, e) = x in controlled (nAdderRev'' n) (a, b, c, d) e

extendWires : ! {a b: Type} -> (c : Type) -> (Simple a, Simple b, Simple c) => Circ(a, b) -> Circ(a * c, b * c)
extendWires a b c circ =
  box (a * c) $ \ z -> let (x, y) = z in ((unbox circ) x, y)

nAdderR : ! (n : Nat) -> Circ(Qubit * Vec Qubit n * Vec Qubit n * (Vec Qubit n * Qubit),
                                   Qubit * Vec Qubit n * Vec Qubit n * (Vec Qubit n * Qubit))
nAdderR n =
  let (m, circ) = boxGarbage (\ x -> uncurry (uncurry (nAdder n)) x) -- circ : Circ(Q * V n * V n, V m * V n * Q)
      circ' = extendWires (Vec Qubit n * Qubit) circ
      cp = box (Vec Qubit m * (Vec Qubit n * Qubit) * (Vec Qubit n * Qubit)) $
               \ x -> let (gs, vq, r) = x
                          (v, q) = vq
                          (v', q') = r
                          (v', v) = cnots v' v
                          (q', q) = cnots q' q
                      in (gs, (v, q), (v', q'))
  in withComputed circ' cp


c_adderR : ! (n : Nat) -> Circ(Qubit * Vec Qubit n * Vec Qubit n * (Vec Qubit n * Qubit) * Qubit,
                               Qubit * Vec Qubit n * Vec Qubit n * (Vec Qubit n * Qubit) * Qubit)
c_adderR n = boxCirc $ \ x -> let (a, b, c, d, e) = x in controlled (nAdderR n) (a, b, c, d) e




