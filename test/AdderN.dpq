-- Due to the set up of runCirc, the call of runCirc always need annotation->
-- Moreover, we don't want to turn type class into
-- full blown prolog.

main :  (Bool * Vec Bool 3 * Vec Bool 3) * (Vec Bool 3 * Bool)
main = runCirc (nAdderRev'' 3)  (False, [False, True, True], [False, False, True], ([False, False, False], False))

