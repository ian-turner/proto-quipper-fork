binaryToNat : ! forall (n : Nat) -> Vec Bool n -> Nat
binaryToNat v =
  case v of
    VNil -> Z
    VCons x xs ->
      case x of
        True -> S (mul two (binaryToNat xs))
	False -> mul two (binaryToNat xs)

idCirc : ! (n : Nat) -> Circ(Vec Qubit n, Vec Qubit n)
idCirc n = box (Vec Qubit n) $ \ x -> x



