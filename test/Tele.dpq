--         in z

teleBox_t1 : Circ (Vec Qubit nine, Vec Qubit nine)
teleBox_t1 = teleBox nine

teleBox' : ! (n : Nat) -> Circ(Vec Qubit n, Vec Qubit n)
teleBox' n = box (Vec Qubit n) $ \ x -> tele_generic n x




bellState : ! (Unit -> Unit)
bellState u =
  let x = Init0 ()
      y = Init0 ()
      x' = H x
      (y', x'') = CNot y x'
      y'' = Meas y'
      x''' = Meas x''
      r = (dynlift x''', dynlift y'')
  in ()


-- ha = bellState ()

teleportation =
  let x = [Init1 (), Init0 (), Init0 (), Init0 (), Init0 (), Init1 ()]
      r = unbox (teleBox six) x
      r' = map Meas r
      r'' = map (\ x -> dynlift x) r'
  in r''

