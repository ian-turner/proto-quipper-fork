module Distill where
import "lib/Prelude.dpq"


cz (x y : Qubit) = let (x, y) = CNot (H x) y in (H x, y)

-- Controlled Y, ignoring the global phase i.
cy (x y : Qubit) =
  let (x, y) = cz x y
      (x, y) = CNot x y
  in (x, y)

-- The five qubit error correcting code. 
fiveQubits : ! (Qubit * Qubit * Qubit *  Qubit * Qubit -> Qubit * Qubit * Qubit * Qubit * Qubit)
fiveQubits input =
  let (a1, a2, a3, a4, a5) = input
      (a1, a5) = CZ a1 a5
      (a2, a5) = CZ a2 a5
      (a3, a5) = CZ a3 a5
      (a2, a4) = CZ a2 a4
      (a3, a4) = CZ a3 a4
      (a5, a4) = CY a5 a4
      (a1, a3) = CZ a1 a3
      (a4, a3) = CZ a4 a3
      (a5, a3) = CY a5 a3
      (a1, a2) = CZ a1 a2
      (a5, a2) = CY a5 a2
      (a3, a1) = CZ a3 a1
      (a5, a1) = CNot a5 a1
    in (H a1, H a2, H a3, H a4, ZGate a5)


cnotFromCZ : !(Qubit * Qubit -> Qubit * Qubit)
cnotFromCZ x =
  let (x, y) = x
      (x, y)= CZ (H x) y
  in (H x, y)

testCZ : Bool * Bool
testCZ =
  measure $ cnotFromCZ (Init1 (), Init0 ())

testCZ2 : Bool * Bool
testCZ2 =
  measure $ CZ (Init1 ()) (Init1 ())

idFromCY : !(Qubit * Qubit -> Qubit * Qubit)
idFromCY x =
  let (x , y) = x
      (x,  y) = CY x y
      (x,  y) = CY x y 
  in (x, y)

testCY1 : Bool * Bool
testCY1 =
  measure $ idFromCY (Init0 (), Init0 ())

testCY2 : Bool * Bool
testCY2 =
  measure $ CY (Init1 ()) (Init0 ())



-- Preparing the initial mixed state.
-- I am not sure how to prepare the mix state.
-- So it is a dummy state for now. 
prepMixedState : ! (Unit -> Qubit)
prepMixedState u = Diag (cos 0.47765831) (sin 0.47765831) (TGate (H (Init0 ())))

-- One round distillation
round1Distill : ! (Unit -> Qubit)
round1Distill u =
  let input = (prepMixedState (), prepMixedState (), prepMixedState (), prepMixedState (), prepMixedState ())
      (a1, a2, a3, a4, a5) = fiveQubits input
      a1' = measure a1
      a2' = measure a2
      a3' = measure a3
      a4' = measure a4
  in if a1' || a2' || a3' || a4' then
     let a = measure a5 : Bool in round1Distill u
     else a5

-- One iteration of distillation
distill : ! (Qubit * Qubit * Qubit *  Qubit * Qubit -> Maybe Qubit)
distill input =
  let 
      (a1, a2, a3, a4, a5) = fiveQubits input
      a1' = measure a1
      a2' = measure a2
      a3' = measure a3
      a4' = measure a4
  in if a1' || a2' || a3' || a4' then
     let a = measure a5 : Bool in Nothing
     else Just a5

-- n round distillation.  The higher n is, the higher the expense and the higher the precision it will be. 
distillation : ! (Nat -> Qubit)
distillation n =
  case n of
    Z -> prepMixedState ()
    S n' -> 
     let q1 = distillation n' 
         q2 = distillation n'
         q3 = distillation n'
         q4 = distillation n'
         q5 = distillation n'
     in
     case distill (q1, q2, q3, q4, q5) of
       Nothing -> distillation n
       Just q -> q


             
      
