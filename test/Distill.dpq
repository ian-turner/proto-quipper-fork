module Distill where
import "lib/Prelude.dpq"


cz (x y : Qubit) = let (x, y) = CNot (H x) y in (H x, y)

-- Controlled Y, ignoring the global phase i.
cxz (x y : Qubit) =
  let (x, y) = cz x y
      (x, y) = CNot x y
  in (x, y)

-- The five qubit error correcting code. 
fiveQubits : ! (Qubit * Qubit * Qubit *  Qubit * Qubit -> Qubit * Qubit * Qubit * Qubit * Qubit)
fiveQubits input =
  let (a1, a2, a3, a4, a5) = input
      (a1, a5) = CZ a1 a5
      (a2, a5) = CZ a2 a5
      (a3, a5) = CZ a3 a5
      (a2, a4) = CZ a2 a4
      (a3, a4) = CZ a3 a4
      (a5, a4) = CY a5 a4
      (a1, a3) = CZ a1 a3
      (a4, a3) = CZ a4 a3
      (a5, a3) = CY a5 a3
      (a1, a2) = CZ a1 a2
      (a5, a2) = CY a5 a2
      (a3, a1) = CZ a3 a1
      (a5, a1) = CNot a5 a1
    in (H a1, H a2, H a3, H a4, ZGate a5)


-- Another five qubit error correcting code. 
fiveQubits' : ! (Qubit * Qubit * Qubit *  Qubit * Qubit -> Qubit * Qubit * Qubit * Qubit * Qubit)
fiveQubits' input = 
  let (a1, a2, a3, a4, a5) = input
      (a1, a4) = CZ a1 a4
      (a3, a4) = CZ a3 a4
      (a5, a4) = cxz a5 a4
      (a1, a3) = CZ a1 a3
      (a2, a3) = CZ a2 a3
      (a5, a3) = CNot a5 a3
      (a5, a2) = CNot a5 a2
      (a5, a1) = cxz a5 a1
   in (H (ZGate a1), H a2, H a3, H (ZGate a4), YGate (H (ZGate a5)))


cnotFromCZ : !(Qubit * Qubit -> Qubit * Qubit)
cnotFromCZ x =
  let (x, y) = x
      (x, y)= CZ (H x) y
  in (H x, y)

testCZ : Bool * Bool
testCZ =
  measure $ cnotFromCZ (Init1 (), Init0 ())

testCZ2 : Bool * Bool
testCZ2 =
  measure $ CZ (Init1 ()) (Init1 ())

idFromCY : !(Qubit * Qubit -> Qubit * Qubit)
idFromCY x =
  let (x , y) = x
      (x,  y) = CY x y
      (x,  y) = CY x y 
  in (x, y)

testCY1 : Bool * Bool
testCY1 =
  measure $ idFromCY (Init0 (), Init0 ())

testCY2 : Bool * Bool
testCY2 =
  measure $ CY (Init1 ()) (Init0 ())



-- Preparing the initial mixed state.
-- I am not sure how to prepare the mix state.
-- So it is a dummy state for now. 
prepMixedState : ! (Unit -> Qubit)
prepMixedState u =
  Diag ((sqrt 2.00000) @ (cos 0.47766)) ((sqrt 2.00000) @ (sin 0.47766)) (TGate (H (Init0 ())))

-- One round distillation
round1Distill : ! (Unit -> Qubit)
round1Distill u =
  let input = (prepMixedState (), prepMixedState (), prepMixedState (), prepMixedState (), prepMixedState ())
      (a1, a2, a3, a4, a5) = fiveQubits input
      a1' = measure a1
      a2' = measure a2
      a3' = measure a3
      a4' = measure a4
  in if a1' || a2' || a3' || a4' then
     let a = measure a5 : Bool in round1Distill u
     else a5

-- One iteration of distillation
distill : ! (Qubit * Qubit * Qubit *  Qubit * Qubit -> Maybe Qubit)
distill input =
  let 
      (a1, a2, a3, a4, a5) = fiveQubits' input
      a1' = measure a1
      a2' = measure a2
      a3' = measure a3
      a4' = measure a4
  in if a1' || a2' || a3' || a4' then
     let a = measure a5 : Bool in Nothing
     else Just a5

-- n round distillation.  The higher n is, the higher the expense and the higher the precision it will be. 
distillation : ! (Nat -> Qubit)
distillation n =
  case n of
    Z -> prepMixedState ()
    S n' -> 
     let q1 = distillation n' 
         q2 = distillation n'
         q3 = distillation n'
         q4 = distillation n'
         q5 = distillation n'
     in
     case distill (q1, q2, q3, q4, q5) of
       Nothing -> distillation n
       Just q -> q


distillation' : ! (Nat -> Maybe Qubit)
distillation' n =
  case n of
    Z -> Just (prepMixedState ())
    S n' -> 
     let q1 = distillation n' 
         q2 = distillation n'
         q3 = distillation n'
         q4 = distillation n'
         q5 = distillation n'
     in
     distill (q1, q2, q3, q4, q5) 



plusState (u : Unit) = H (Init0 ())

zeroState (u : Unit) = Init0 ()

a_state (u : Unit) = TGate (plusState ())

t_gate_from_a (input : Qubit) =
  let a = a_state ()
      (a, input) = CNot a input
  in if measure a then SGate input else input

t_dagger (input : Qubit) = SGate (ZGate (t_gate_from_a input))




-- Repeat the distillation until the measurement result is desirable.
oneBlockCode (u : Unit) =
  let a1 = plusState ()
      a2 = plusState ()
      a3 = plusState ()
      a4 = zeroState ()
      a5 = zeroState ()       
      a6 = zeroState ()       
      a7 = zeroState ()
      output1 = plusState ()
      output2 = plusState ()
      (a4, a2) = CNot a4 a2
      (a5, a3) = CNot a5 a3
      (a6, a1) = CNot a6 a1
      (a7, a1) = CNot a7 a1
      (a6, output1) = CNot a6 output1
      a6 = t_gate_from_a a6
      (a5, a6) = CNot a5 a6
      (a7, output2) = CNot a7 output2
      (a6, a4) = CNot a6 a4
      a7 = t_gate_from_a a7
      (a4, a5) = CNot a4 a5
      (a6, a7) = CNot a6 a7
      (a7, a5) = CNot a7 a5
      (a5, a6) = CNot a5 a6
      (a2, a3, a4, a5, a6, a7) = (t_gate_from_a a2, t_gate_from_a a3, t_gate_from_a a4, t_gate_from_a a5, t_gate_from_a a6, t_gate_from_a a7)
      (a2, a1) = CNot a2 a1
      (a3, a1) = CNot a3 a1
      (a4, a1) = CNot a4 a1
      (a5, a1) = CNot a5 a1
      (a6, a1) = CNot a6 a1
      (a7, a1) = CNot a7 a1
      (a2, a3, a4, a5, a6, a7) = (t_dagger a2, t_dagger a3, t_dagger a4, t_dagger a5, t_dagger a6, t_dagger a7)
      (a1, a2, a3, a4, a5, a6, a7) = (H a1, H a2, H a3, H a4, H a5, H a6, H a7)
      a1 = measure a1 : Bool      
      a2 = measure a2 : Bool
      a3 = measure a3 : Bool
      a4 = measure a4 : Bool
      a5 = measure a5 : Bool
      a6 = measure a6 : Bool
      a7 = measure a7 : Bool
  in if a1 || a2 || a3 || a4 || a5 || a6 || a7
     then let _ = measure output1 : Bool
              _ = measure output2 : Bool
          in oneBlockCode ()
     else (output1, output2)      

oneBlockCode' (u : Unit) =
  let a1 = plusState ()
      a2 = plusState ()
      a3 = plusState ()
      a4 = zeroState ()
      a5 = zeroState ()       
      a6 = zeroState ()       
      a7 = zeroState ()
      output1 = plusState ()
      output2 = plusState ()
      (a4, a2) = CNot a4 a2
      (a5, a3) = CNot a5 a3
      (a6, a1) = CNot a6 a1
      (a7, a1) = CNot a7 a1
      (a6, output1) = CNot a6 output1
      a6 = t_gate_from_a a6
      (a5, a6) = CNot a5 a6
      (a7, output2) = CNot a7 output2
      (a6, a4) = CNot a6 a4
      a7 = t_gate_from_a a7
      (a4, a5) = CNot a4 a5
      (a6, a7) = CNot a6 a7
      (a7, a5) = CNot a7 a5
      (a5, a6) = CNot a5 a6
      (a2, a3, a4, a5, a6, a7) = (t_gate_from_a a2, t_gate_from_a a3, t_gate_from_a a4, t_gate_from_a a5, t_gate_from_a a6, t_gate_from_a a7)
      (a2, a1) = CNot a2 a1
      (a3, a1) = CNot a3 a1
      (a4, a1) = CNot a4 a1
      (a5, a1) = CNot a5 a1
      (a6, a1) = CNot a6 a1
      (a7, a1) = CNot a7 a1
      (a2, a3, a4, a5, a6, a7) = (t_dagger a2, t_dagger a3, t_dagger a4, t_dagger a5, t_dagger a6, t_dagger a7)
      (a1, a2, a3, a4, a5, a6, a7) = (H a1, H a2, H a3, H a4, H a5, H a6, H a7)
      a1 = measure a1 : Bool      
      a2 = measure a2 : Bool
      a3 = measure a3 : Bool
      a4 = measure a4 : Bool
      a5 = measure a5 : Bool
      a6 = measure a6 : Bool
      a7 = measure a7 : Bool
      _ = measure output1 : Bool
      _ = measure output2 : Bool
  in ()
  -- in if a1 || a2 || a3 || a4 || a5 || a6 || a7
  --    then let _ = measure output1 : Bool
  --             _ = measure output2 : Bool
  --         in oneBlockCode ()
  --    else (output1, output2)      

t_gate (input a : Qubit) =
  let (a, input) = CNot a input
  in if measure a then SGate input else input

t_gate_inv (input a : Qubit) = SGate (ZGate (t_gate input a))


oneBlock (input : Qubit * Qubit * Qubit * Qubit * Qubit * Qubit * Qubit * Qubit * Qubit * Qubit * Qubit * Qubit * Qubit * Qubit) =
  let (s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14)= input 
      a1 = plusState ()
      a2 = plusState ()
      a3 = plusState ()
      a4 = zeroState ()
      a5 = zeroState ()       
      a6 = zeroState ()       
      a7 = zeroState ()
      output1 = plusState ()
      output2 = plusState ()
      (a4, a2) = CNot a4 a2
      (a5, a3) = CNot a5 a3
      (a6, a1) = CNot a6 a1
      (a7, a1) = CNot a7 a1
      (a6, output1) = CNot a6 output1
      a6 = t_gate a6 s13
      (a5, a6) = CNot a5 a6
      (a7, output2) = CNot a7 output2
      (a6, a4) = CNot a6 a4
      a7 = t_gate a7 s14
      (a4, a5) = CNot a4 a5
      (a6, a7) = CNot a6 a7
      (a7, a5) = CNot a7 a5
      (a5, a6) = CNot a5 a6
      (a2, a3, a4, a5, a6, a7) = (t_gate a2 s1, t_gate a3 s2, t_gate a4 s3, t_gate a5 s4, t_gate a6 s5, t_gate a7 s6)
      (a2, a1) = CNot a2 a1
      (a3, a1) = CNot a3 a1
      (a4, a1) = CNot a4 a1
      (a5, a1) = CNot a5 a1
      (a6, a1) = CNot a6 a1
      (a7, a1) = CNot a7 a1
      (a2, a3, a4, a5, a6, a7) = (t_gate_inv a2 s7, t_gate_inv a3 s8, t_gate_inv a4 s9, t_gate_inv a5 s10, t_gate_inv a6 s11, t_gate_inv a7 s12)
      (a1, a2, a3, a4, a5, a6, a7) = (H a1, H a2, H a3, H a4, H a5, H a6, H a7)
      a1 = measure a1 : Bool      
      a2 = measure a2 : Bool
      a3 = measure a3 : Bool
      a4 = measure a4 : Bool
      a5 = measure a5 : Bool
      a6 = measure a6 : Bool
      a7 = measure a7 : Bool
  in if a1 || a2 || a3 || a4 || a5 || a6 || a7
     then let _ = measure output1 : Bool
              _ = measure output2 : Bool
          in Nothing
     else Just (output1, output2)      


prepMixedState2 (u : Unit) =
  (a_state (), a_state ())
  
distillation2 : ! (Nat -> Qubit * Qubit)
distillation2 n =
  case n of
    Z -> prepMixedState2 ()
    S n' -> 
     let (q1, q2) = distillation2 n' 
         (q3, q4) = distillation2 n'
         (q5, q6) = distillation2 n'
         (q7, q8) = distillation2 n'
         (q9, q10) = distillation2 n'
         (q11, q12) = distillation2 n'
         (q13, q14) = distillation2 n'
     in
     case oneBlock (q1, q2, q3, q4, q5, q6, q7, q8, q9, q10, q11, q12, q13, q14) of
       Nothing -> distillation2 n
       Just q -> q

distillation2' : ! (Nat -> Maybe (Qubit * Qubit))
distillation2' n =
  case n of
    Z -> Just (prepMixedState2 ())
    S n' -> 
     let (q1, q2) = distillation2 n' 
         (q3, q4) = distillation2 n'
         (q5, q6) = distillation2 n'
         (q7, q8) = distillation2 n'
         (q9, q10) = distillation2 n'
         (q11, q12) = distillation2 n'
         (q13, q14) = distillation2 n'
     in
      oneBlock (q1, q2, q3, q4, q5, q6, q7, q8, q9, q10, q11, q12, q13, q14) 
     
