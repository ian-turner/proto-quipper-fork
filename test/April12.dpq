module Apil12 where
import "lib/Prelude.dpq"

-- controlled ZGate : Qubit -> Qubit

-- gate {1,1,1} SGate : Qubit -> Qubit

-- gate {1,1,1} ZGate : Qubit -> Qubit

z_gate : ! forall s -> (Simple s) => Qubit -> s -> Qubit * s
z_gate q s = controlled (box Qubit ZGate) q s

s_gate : ! forall s -> (Simple s) => Qubit -> s -> Qubit * s
s_gate q s = controlled (box Qubit SGate) q s


cZ : ! (Qubit -> Qubit -> Qubit * Qubit)
cZ x y = z_gate x y

-- f : !(Qubit -> Qubit * Qubit)
-- f q = cZ q q 

cS : ! (Qubit -> Qubit -> Qubit * Qubit)
cS x y = s_gate x y

box_cZ : Circ(Qubit * Qubit, Qubit * Qubit)
box_cZ = box (Qubit * Qubit) $ \ x -> uncurry cZ x

box_cS : Circ(Qubit * Qubit, Qubit * Qubit)
box_cS = box (Qubit * Qubit) $ \ x -> uncurry cS x

mapH : ! forall (n : Nat) -> Vec Qubit n -> Vec Qubit n
mapH l = map H l

box_mapH : ! (n : Nat) -> Circ(Vec Qubit n, Vec Qubit n)
box_mapH n = box (Vec Qubit n) $ \ x -> mapH x

