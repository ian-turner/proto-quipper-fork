module RC where

-- Basic linear resources
object Qubit
object Bit

-- Parameters
data Bool = True | False
data Nat = Z | S Nat

-- Some basic circuits
gate Init0 : Unit -> Qubit : Term0

gate H : Qubit -> Qubit : H 

gate CNot : Qubit -> Qubit -> Qubit * Qubit : CNot

-- f1 : ! (Qubit -> Qubit * Qubit)
-- f1 x = CNot x x

-- * Addition by recursion
add : !(Nat -> Nat -> Nat)
add n m =
  case n of
    Z -> m
    S n' -> S (add n' m)

test1 : Nat
test1 = let x = 1 in add x x


bell00 : !(Unit -> Qubit * Qubit)
bell00 u = 
  let x = Init0 ()
      y = Init0 ()
      x' = H x
  in CNot y x'

bell00Box : Circ(Unit, Qubit * Qubit)
bell00Box = box Unit bell00



simple Vec a : Nat -> Type where
  Vec a Z = VNil
  Vec a (S n) = VCons a (Vec a n)

simple DVec a : Nat -> Type where
  DVec a Z = DNil 
  DVec a (S n) = DCons (Vec a n) (DVec a n)

-- Dependent vector appending
append : ! forall a (n m : Nat) -> Vec a n -> Vec a m -> Vec a (add n m)
append v1 v2 =
  case v1 of
    VNil -> v2
    VCons x xs -> VCons x (append xs v2)

-- Controlled R gate, the second qubit is the control bit.
gate R Nat : Qubit -> Qubit -> Qubit * Qubit : R_Inv

rotate : ! forall (y : Nat) -> Nat -> Qubit -> Vec Qubit y -> Qubit * Vec Qubit y
rotate m q v =
    case v of
      VNil -> (q, VNil)
      VCons x xs ->
        let (q', x') = R m q x
            (q'', xs') = rotate (S m) q' xs
        in (q'', VCons x' xs')

qft : ! forall (n : Nat) -> Vec Qubit n -> Vec Qubit n
qft v =
  case v of
    VNil -> VNil
    VCons q qs ->
      let q' = H q
          (q'', qs') = rotate 2 q' qs
          qs'' = qft qs'
      in VCons q'' qs''

qftBox : ! (n : Nat) -> Circ(Vec Qubit n, Vec Qubit n)
qftBox n = box (Vec Qubit n) (\x -> qft x)



-- Toffoli gate with signed controls. The first qubit is the target.
-- The second qubit is a control with sign indicated
-- by the first boolean parameter (positive or negative).
-- Similarly, the third qubit is also a control with
-- sign indicated by the second boolean parameter.

gate ToffoliGate Bool Bool : Qubit -> Qubit -> Qubit -> Qubit * Qubit * Qubit : ToffoliGate

class Monad (m : Type -> Type) where
  return : forall a -> a -> m a
  bind : forall a b -> m a -> (a -> m b) -> m b

pure : ! forall (m : Type -> Type) ->
          (Monad m) => forall (a : Type) -> a -> m a
pure x = return x

seq : ! forall (m : Type -> Type) ->
            (Monad m) =>
              forall b ->
                 m Unit -> m b -> m b
seq x f = bind x (λ u -> f)

join : ! forall a (m : Type -> Type) -> (Monad m) => m (m a) -> m a
join mma =
  bind mma (λ ma -> ma)

ap : ! forall a b (m : Type -> Type) -> (Monad m) =>  m (a -> b) -> m a -> m b
ap f x =
  bind f (λ g ->
  bind x (λ y ->
  return (g y)))

-------------------------

data WithGarbage a = WG ((n : Nat) * Vec Qubit n) a

unGarbage : ! forall a -> WithGarbage a -> (n : Nat) * Vec Qubit n * a
unGarbage z =
  let WG ex a = z
      (n, v) = ex
  in (n, (v, a))

instance Monad WithGarbage where
  return x =
    WG (Z, VNil) x
  bind wg f =
    let WG ng r = wg
        (n, g) = ng
        WG mg' r' = f r
        (m, g') = mg'
    in WG (add n m, append g g') r'

class Disposable a where
  dispose : a -> WithGarbage Unit

instance Disposable Qubit where
  dispose q = WG (1, VCons q VNil) ()


infixl 13 ||
infixl 8 &&

(&&) : !(Qubit -> Qubit -> WithGarbage Qubit)
(&&) x y = do
  let z = Init0 ()
      (z', y', x') =  ToffoliGate True True z y x
  dispose x'
  dispose y'
  return z'

(||) : !(Qubit -> Qubit -> WithGarbage Qubit)
(||) x y = do
  let z = Init0 ()
      (z', y', x') = ToffoliGate False False z y x
  dispose x'
  dispose y'
  return z'

xor : !(Qubit -> Qubit -> WithGarbage Qubit)
xor x y = do
  let z = Init0 ()
      (z', x') = CNot z x
      (z'', y') = CNot z' y
  dispose x'
  dispose y'
  return z''

copy3 : !(Qubit -> Qubit * Qubit * Qubit)
copy3 q =
   let (q1, q2) = CNot (Init0 ()) q
       (q1, q3) = CNot (Init0 ()) q1
   in (q1, q2, q3)

-- Adder: 
-- s = a `xor` b `xor` carryIn1
-- carryOut = (a && b) || (a && carryIn) || (b && carryIn)

adder : !(Qubit * Qubit * Qubit -> WithGarbage (Qubit * Qubit))
adder input = do
  let (a, b, carryIn) = input
      (a1, a2, a3) = copy3 a
      (b1, b2, b3) = copy3 b 
      (carryIn1, carryIn2, carryIn3) = copy3 carryIn
  r1 <- a1 `xor` b1
  s <- r1 `xor` carryIn1
  r2 <- a2 && b2
  r3 <- a3 && carryIn2
  r4 <- r2 || r3
  r5 <- b3 && carryIn3
  carryOut <- r4 || r5
  return (s, carryOut)

-- A much better version using idiom brackets.
adder2 : !(Qubit * Qubit * Qubit -> WithGarbage (Qubit * Qubit))
adder2 input = do
  let (a, b, carryIn) = input
      (a1, a2, a3) = copy3 a
      (b1, b2, b3) = copy3 b 
      (carryIn1, carryIn2, carryIn3) = copy3 carryIn 
  s <- [| (a1 `xor` b1) `xor` (pure carryIn1)|]   
  carryOut <- [| [| (a2 && b2) || (a3 && carryIn2) |] || (b3 && carryIn3) |]
  return (s, carryOut)


adderE : (n : Nat) * Circ(Qubit * Qubit * Qubit, Vec Qubit n * (Qubit * Qubit))
adderE =
  let (n, circ) =
    existsBox (Qubit * Qubit * Qubit)
     (λx -> Vec Qubit x * (Qubit * Qubit)) (λz -> unGarbage (adder z))
  in (n, circ)


with_computed : ! forall d -> (a b c : Type) ->(Simple a, Simple b) =>
                !(a -> WithGarbage b) -> !(c * b -> d * b) -> (c * a -> d * a)
with_computed a b c f g input =
  let (y, x) = input
      (_, circ) = existsBox a (\x -> Vec Qubit x * b) (\z -> unGarbage (f z))
      h' = unbox circ
      (v, r) = h' x
      circ_rev = unbox (reverse circ)
      (d, r') = g (y, r)
      res = circ_rev (v, r')
  in (d, res)

runGarbage : ! forall c -> {a b d : Type} -> (Simple a , Simple b, Simple c, Simple d) =>
                     !(a -> WithGarbage b) -> !(d * b -> c * b) -> Circ(d * a, c * a)
runGarbage a b d f g =
   box (d * a) (λ x -> with_computed a b d f g x)

-- first two qubit are 0's. the second two qubits are copied to output.
copy : !((Qubit * Qubit) * (Qubit * Qubit) -> (Qubit * Qubit) * (Qubit * Qubit))
copy p = 
  let (in1, in2, q) = p
      (q1, q2) = q
      (q3, q4) = CNot in1 q1
      (q5, q6) = CNot in2 q2
  in (q3, q5, (q4, q6))

adderRev : Circ(Qubit * Qubit * (Qubit * Qubit * Qubit),
                 Qubit * Qubit * (Qubit * Qubit * Qubit))
adderRev = runGarbage adder copy




