module RC where

data Bool = True | False

data Nat = Z | S Nat

object Qubit

object Bit

gate Init0 : Unit -> Qubit : Term0

gate Init1 : Unit -> Qubit : Term1

#Controllable
gate H : Qubit -> Qubit : H 


#Controllable
gate CNot : Qubit -> Qubit -> Qubit * Qubit : CNot

-- Controlled R gate, the second qubit is the control bit.
#Controllable
gate R Nat : Qubit -> Qubit -> Qubit * Qubit : R_Inv

-- Toffoli gate with signed controls. The first qubit is the target.
-- The second qubit is a control with sign indicated
-- by the first boolean parameter (positive or negative).
-- Similarly, the third qubit is also a control with
-- sign indicated by the second boolean parameter.

#Controllable
gate ToffoliGate Bool Bool : Qubit -> Qubit -> Qubit -> Qubit * Qubit * Qubit : ToffoliGate

gate Discard : Bit -> Unit

gate C_X : Qubit -> Bit -> Qubit * Bit : C_X

gate C_Z : Qubit -> Bit -> Qubit * Bit : C_Z

-- Measurement gate.
gate Meas : Qubit -> Bit


-- * Addition by recursion
add : !(Nat -> Nat -> Nat)
add n m =
  case n of
    Z -> m
    S n' -> S (add n' m)

bell00 : ! (Unit -> Qubit * Qubit)
bell00 u = 
  let x = Init0 ()
      y = Init0 ()
      x' = H x
  in CNot y x'

bell00Box : Circ(Unit, Qubit * Qubit)
bell00Box = box Unit bell00


bellMeas : ! (Qubit -> Qubit -> Bit * Bit)
bellMeas x y = 
  let (x', y') = CNot x y
      y'' = H y'
  in (Meas x', Meas y'') 

bellMeasBox : Circ(Qubit * Qubit, Bit * Bit)
bellMeasBox =
  box (Qubit * Qubit) (\ x -> let (a, b) = x in bellMeas a b)

tele : ! (Qubit -> Qubit)
tele phi =
  let (bob, alice) = bell00 ()
      (a', phi') = bellMeas alice phi
      (bob', a'') = C_X bob a'
      (r, phi'') = C_Z bob' phi'
      u = Discard phi''
      u = Discard a''
  in r         

teleBox : Circ(Qubit, Qubit)
teleBox = box Qubit tele

simple Vec a : Nat -> Type where
  Vec a Z = VNil
  Vec a (S n) = VCons a (Vec a n)

simple DVec a : Nat -> Type where
  DVec a Z = DNil 
  DVec a (S n) = DCons (Vec a n) (DVec a n)

-- The following are two examples of non-simple declarations. Both
-- are rejected by the type checker. 

